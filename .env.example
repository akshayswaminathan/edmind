# Copy to .env and fill in. .env is gitignored.

# ── Backend (server.cjs) ─────────────────────────────────────────────────────
# Used by the scoring / patient-chat / order / feedback / suggest-findings APIs.
OPENAI_API_KEY=
# Optional: override the chat/order model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
# Optional: speech-to-text for the dictation mic
# DEEPGRAM_API_KEY=

# ── Shared finding library (database) ────────────────────────────────────────
# A Vercel KV / Upstash-compatible key-value store holds the shared library that
# every user loads. Create a KV store in the Vercel dashboard and it injects
# these. Without them, the shared endpoints degrade gracefully and the app runs
# from its built-in + per-browser library.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Server-side gate for POST /api/library (publishing to the shared library).
# The admin enters this token in the admin view; it is NOT in the client bundle.
# Publishing is disabled until this is set.
ADMIN_TOKEN=

# ── Admin view passcode (client, Option A gate) ──────────────────────────────
# Guards the "Finding Library — Admin" screen. This is obscurity, not real
# security: admin edits are stored per-browser (localStorage), so the passcode
# only keeps casual users out of the config screen. Leave unset to leave the
# admin view open (e.g. local development).
#
# NOTE: VITE_* vars are embedded in the client bundle at build time — do not put
# a real secret here. If admin edits ever become shared/authoritative, move to a
# server-checked token (see docs/mdm-finding-framework.md).
VITE_ADMIN_PASSCODE=
